<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LyricsPlayer.MainWindow"
        Title="動態歌詞播放器"
        Icon="avares://LyricsPlayer/Assets/app-icon.png"
        Width="500" Height="800" MinWidth="380" MinHeight="600"
        FontFamily="Microsoft JhengHei, PingFang TC, sans-serif">
    <DockPanel Background="#171130">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,24,0,10">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,7">
                <Button x:Name="TabSong1" Content="最瞎結婚理由" FontSize="13" Padding="16,6" MinHeight="0" Margin="5" />
                <Button x:Name="TabSong2" Content="鋒塗力百年夢" FontSize="13" Padding="16,6" MinHeight="0" Margin="5" />
                <Button x:Name="TabSong3" Content="水電進化 Show" FontSize="13" Padding="16,6" MinHeight="0" Margin="5" />
                <Button x:Name="TabSong4" Content="喵布布本喵掉的毛" FontSize="13" Padding="16,6" MinHeight="0" Margin="5" />
                <Button x:Name="TabSong5" Content="鋒兄的傳奇人生" FontSize="13" Padding="16,6" MinHeight="0" Margin="5" />
                <Button x:Name="TabSong6" Content="塗哥水電王子爆紅" FontSize="13" Padding="16,6" MinHeight="0" Margin="5" />
                <Button x:Name="TabSong7" Content="鋒兄進化 Show！🔥" FontSize="13" Padding="16,6" MinHeight="0" Margin="5" />
                <Button x:Name="TabSong8" Content="我與國中畢業紀念冊的對話" FontSize="13" Padding="16,6" MinHeight="0" Margin="5" />
                <Button x:Name="TabSong9" Content="統一發票頭獎得主鋒兄威力彩頭獎得主塗哥" FontSize="13" Padding="16,6" MinHeight="0" Margin="5" />
            </WrapPanel>
            <TextBlock x:Name="TitleText" Text="最瞎結婚理由" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="12,0" FontSize="32" FontWeight="Bold" Foreground="#FFD75E" />
            <TextBlock x:Name="SubtitleText" Text="鋒兄 × 小塗 × 牙妹 × 魚妹｜今彩五三九牽紅線" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="12,0" FontSize="13" Foreground="#C9B6E4" />
            <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                <StackPanel x:Name="AvatarFeng" Margin="9,0" Spacing="6" Opacity="0.5">
                    <Border x:Name="BorderFeng" Width="76" Height="76" CornerRadius="38" ClipToBounds="True" BorderThickness="3" BorderBrush="#4A3768" Background="#241436">
                        <Image Source="avares://LyricsPlayer/Assets/feng.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="鋒兄" HorizontalAlignment="Center" FontSize="13" Foreground="#F4ECFF" />
                </StackPanel>
                <StackPanel x:Name="AvatarTu" Margin="9,0" Spacing="6" Opacity="0.5">
                    <Border x:Name="BorderTu" Width="76" Height="76" CornerRadius="38" ClipToBounds="True" BorderThickness="3" BorderBrush="#4A3768" Background="#241436">
                        <Image Source="avares://LyricsPlayer/Assets/tu.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="小塗" HorizontalAlignment="Center" FontSize="13" Foreground="#F4ECFF" />
                </StackPanel>
                <StackPanel x:Name="AvatarYa" Margin="9,0" Spacing="6" Opacity="0.5">
                    <Border x:Name="BorderYa" Width="76" Height="76" CornerRadius="38" ClipToBounds="True" BorderThickness="3" BorderBrush="#4A3768" Background="#241436">
                        <Image Source="avares://LyricsPlayer/Assets/ya.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="牙妹" HorizontalAlignment="Center" FontSize="13" Foreground="#F4ECFF" />
                </StackPanel>
                <StackPanel x:Name="AvatarYu" Margin="9,0" Spacing="6" Opacity="0.5">
                    <Border x:Name="BorderYu" Width="76" Height="76" CornerRadius="38" ClipToBounds="True" BorderThickness="3" BorderBrush="#4A3768" Background="#241436">
                        <Image Source="avares://LyricsPlayer/Assets/yu.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="魚妹" HorizontalAlignment="Center" FontSize="13" Foreground="#F4ECFF" />
                </StackPanel>
                <StackPanel x:Name="AvatarMiao" Margin="9,0" Spacing="6" Opacity="0.5">
                    <Border x:Name="BorderMiao" Width="76" Height="76" CornerRadius="38" ClipToBounds="True" BorderThickness="3" BorderBrush="#4A3768" Background="#241436">
                        <Image Source="avares://LyricsPlayer/Assets/miao.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="喵布布" HorizontalAlignment="Center" FontSize="13" Foreground="#F4ECFF" />
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="12,10">
            <Button x:Name="PlayBtn" Content="▶" Width="44" Height="44" FontSize="16" />
            <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Margin="12,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TimeLabel" Grid.Column="2" Text="0:00 / 0:00" FontSize="12" Foreground="#C9B6E4" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer x:Name="LyricsScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LyricsPanel" Margin="20,12,20,320" />
        </ScrollViewer>
    </DockPanel>
</Window>
