<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="10dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <Button
                android:id="@+id/tabSong1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="5dp"
                android:text="最瞎結婚理由"
                android:textSize="13sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabSong2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="5dp"
                android:text="鋒塗力百年夢"
                android:textSize="13sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabSong3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="5dp"
                android:text="水電進化 Show"
                android:textSize="13sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabSong4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="5dp"
                android:text="喵布布本喵掉的毛"
                android:textSize="13sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabSong5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="5dp"
                android:text="鋒兄的傳奇人生"
                android:textSize="13sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabSong6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="5dp"
                android:text="塗哥水電王子爆紅"
                android:textSize="13sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabSong7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="5dp"
                android:text="鋒兄進化 Show！🔥"
                android:textSize="13sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabSong8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="5dp"
                android:text="我與國中畢業紀念冊的對話"
                android:textSize="13sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/tabSong9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="5dp"
                android:text="統一發票頭獎得主鋒兄威力彩頭獎得主塗哥"
                android:textSize="13sp"
                android:stateListAnimator="@null" />
        </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="最瞎結婚理由"
            android:textColor="@color/gold"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/songSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="鋒兄 × 小塗 × 牙妹 × 魚妹｜今彩五三九牽紅線"
            android:textColor="@color/subtitle"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:id="@+id/avatar_feng"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/feng"
                    android:scaleType="centerCrop"
                    android:contentDescription="鋒兄" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="鋒兄"
                    android:textColor="#F4ECFF"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:id="@+id/avatar_tu"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/tu"
                    android:scaleType="centerCrop"
                    android:contentDescription="小塗" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="小塗"
                    android:textColor="#F4ECFF"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:id="@+id/avatar_ya"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ya"
                    android:scaleType="centerCrop"
                    android:contentDescription="牙妹" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="牙妹"
                    android:textColor="#F4ECFF"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:id="@+id/avatar_yu"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/yu"
                    android:scaleType="centerCrop"
                    android:contentDescription="魚妹" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="魚妹"
                    android:textColor="#F4ECFF"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:id="@+id/avatar_miao"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/miao"
                    android:scaleType="centerCrop"
                    android:contentDescription="喵布布" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="喵布布"
                    android:textColor="#F4ECFF"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/lyricsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/lyricsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="300dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/player_bg"
        android:padding="12dp">

        <Button
            android:id="@+id/playBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="▶"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/timeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00 / 0:00"
            android:textColor="@color/subtitle"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
